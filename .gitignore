# .gitignore for R Smart Wellness Analytics Project

# R specific files
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj

# RStudio files
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Processed data (keep raw data)
# MODIFIED: Including processed data for portfolio showcase
# data/processed/*
!data/processed/.gitkeep

# Logs
# MODIFIED: Including logs for transparency
# logs/*.txt
# logs/*.log

# Outputs
# MODIFIED: Including plots and tables for portfolio showcase
# outputs/plots/*
# outputs/tables/*
# *.png
# *.jpg
# *.svg
# *.pdf

# SQLite databases
# MODIFIED: Including database for complete project showcase
# *.db
# *.sqlite
# *.sqlite3

# RMarkdown outputs
reports/*.html
reports/*.pdf
reports/*_files/

# System files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Temporary files
tmp/
temp/
*.tmp

# Cache
cache/
.cache/

# Package management
renv/
packrat/

# IDE specific
.vscode/
.idea/
